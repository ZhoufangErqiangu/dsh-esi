{
  "name": "@dsh-esi/plugin-esi",
  "version": "0.2.2",
  "description": "DSH plugin bridging EVE Online ESI API and SDE static data with a small always-visible tool surface plus on-demand endpoint materialization.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9",
    "dsh": "^0.2.2-rc.5"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "gen": "node scripts/gen-catalog.mjs",
    "gen:check": "node scripts/gen-catalog.mjs --check",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'tests/*.test.mjs'",
    "verify": "npm run gen:check && npm run typecheck && npm run test && npm run build && node scripts/verify-client.mjs",
    "prepublishOnly": "npm run verify",
    "prepare": "tsdown",
    "push": "git pull && npm version patch && git push && git push --tags"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@types/node": "^24",
    "@types/react": "^18.3.0",
    "fflate": "^0.8.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
